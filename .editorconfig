root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120
continuation_indent_size = 8
ij_java_continuation_indent_size = 8

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
continuation_indent_size = 4
ij_kotlin_continuation_indent_size = 4

[gradlew.bat]
end_of_line = crlf
